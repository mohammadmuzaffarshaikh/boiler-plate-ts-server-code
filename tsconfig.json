{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS", // ✅ Use stable ESM for Node.js (not CommonJS)
    // "moduleResolution": "", // ✅ Match module system for "NodeNext"
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*"]
    },
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["es2020", "dom"],
    "typeRoots": ["./node_modules/@types"],
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
