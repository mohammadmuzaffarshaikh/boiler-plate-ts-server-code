{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS", // ✅ Use stable ESM for Node.js (not CommonJS)
    // "moduleResolution": "", // ✅ Match module system for "NodeNext"
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // es2022 is types-only (emit is governed by "target" above). Node 20
    // implements all of ES2022, and without it `new Error(msg, { cause })` is
    // a type error while ESLint's preserve-caught-error rule demands it.
    "lib": ["es2022", "dom"],
    "typeRoots": ["./node_modules/@types"],
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
