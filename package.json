{
  "name": "nodejs-express-app",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "author": "Muzaffar Shaikh",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "pm2 start ecosystem.config.json --no-daemon",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:test": "docker-compose -f docker-compose.yml -f docker-compose.test.yml up",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@types/compression": "^1.8.1",
    "@types/morgan": "^1.9.10",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^10.9.1",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.11.1",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.6",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pm2": "^7.1.2",
    "prisma": "^7.10.1",
    "rate-limit-redis": "^6.0.2",
    "resend": "^6.37.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "coveralls": "^3.1.1",
    "eslint": "^10.14.0",
    "faker": "^6.6.6",
    "husky": "^9.1.7",
    "install": "^0.13.0",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "node-mocks-http": "^1.18.1",
    "nodemon": "^3.1.14",
    "npm": "^11.21.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "ip-address": ">=10.7.6"
    }
  }
