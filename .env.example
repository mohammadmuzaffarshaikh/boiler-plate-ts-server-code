# Required: development | production | test
NODE_ENV=development

# Node server port
PORT=8080

# Public site URL (used in password reset links)
SITE_URL=http://localhost:5173

# Postgres connection string (used by Prisma + the pg driver adapter)
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5432/test

# JWT
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_MINUTES=10080
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_INVITE_USER_EXPIRATION_MINUTES=10080

# Auth — login lockout
MAX_LOGIN_ATTEMPTS=10
ACCOUNT_LOCK_TIME_MINUTES=15

# Cookies (production cross-subdomain sharing only; leave blank otherwise)
COOKIE_DOMAIN=

# CORS — comma-separated list. Leave blank to allow any origin (dev only).
ALLOWED_ORIGINS=http://localhost:5173

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# CRON schedules (UTC)
CLEANUP_TOKENS_CRON=0 0 * * *
CLEANUP_SESSIONS_CRON=0 2 * * *
