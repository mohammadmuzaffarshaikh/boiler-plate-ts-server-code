# Copy to .env and fill in. Full reference: README.md -> Environment variables.

# --- Core ---
NODE_ENV=development
PORT=8080
# Origin that password-reset and verification links are built against.
# REQUIRED in production — without it links are sent as 'undefined/...'.
SITE_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5432/test

# --- Seed / first account (prisma/seed.ts, not read by the API) ---
# In development these are optional and default to admin@example.com /
# Admin12345, alongside a fixed staff account.
#
# In production they are REQUIRED and are the ONLY way to create the first
# account: /auth/register is development-only and there is no invite route
# yet. The seed creates the admin if it is absent and leaves it untouched if
# it already exists, so re-running never resets a live password.
#
# The password must satisfy the app's own rule: 8+ characters, at least one
# letter and one number. Remove both variables from the environment once the
# account exists.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345

# --- Database pool ---
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=1000

# --- JWT ---
# Minimum 20 characters, enforced at boot. Generate the real one with
# `openssl rand -base64 32` — a short secret is brute-forceable offline
# from a single captured token, and forges any user and any role.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_MINUTES=10080
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_INVITE_USER_EXPIRATION_MINUTES=10080

# --- Password hashing ---
# bcrypt work factor. Each step doubles the cost; the floor is 10 (OWASP) and
# the process refuses to start below it. Raising this does not touch existing
# hashes — they are upgraded on the owner's next successful login.
BCRYPT_ROUNDS=12

# Lifetime of a native login's authorization code, in SECONDS. It covers one
# round trip from the login response to /auth/token-exchange, so the ceiling
# is deliberately low (max 300). Browser logins never see one.
AUTH_CODE_EXPIRATION_SECONDS=60

# --- Login lockout (ACCOUNT_LOCK_TIME_MINUTES is also the attempt window) ---
MAX_LOGIN_ATTEMPTS=10
ACCOUNT_LOCK_TIME_MINUTES=10

# Refuse login for an unverified mailbox. Keep false until a verification
# email is actually sent, or every account is locked out. ADMIN is exempt.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- Cookies & CORS (blank = same-origin / any origin) ---
COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:5173

# --- HTTP ---
# Reverse-proxy hops to trust for req.ip. 0 = exposed directly, Cloudflare ->
# LB -> app = 2. Too low buckets all traffic into one rate limit; too high
# lets callers forge X-Forwarded-For.
TRUST_PROXY=0
BODY_LIMIT=100kb

# --- Rate limits (successful auth requests are not counted) ---
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MINUTES=15
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_PASSWORD_RESET_WINDOW_MINUTES=60
RATE_LIMIT_PASSWORD_RESET_IP_MAX=10
RATE_LIMIT_PASSWORD_RESET_EMAIL_MAX=3

# --- Cron (UTC) ---
CLEANUP_TOKENS_CRON=0 0 * * *
CLEANUP_SESSIONS_CRON=0 2 * * *
CLEANUP_FILES_CRON=0 3 * * *

# --- Google sign-in (optional; blank = disabled). No client secret: GIS ID-token flow ---
GOOGLE_CLIENT_ID=

# --- Cloudflare R2 (optional; the four credentials are required when enabled) ---
R2_ENABLED=false
# Origin only — no bucket, no trailing slash. The bucket is appended per request.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read URL - custom domain or r2.dev, NOT the signed S3 endpoint.
R2_PUBLIC_URL=https://media.example.com

# --- Uploads ---
UPLOAD_MAX_IMAGE_MB=10
# 95, not 100: Cloudflare rejects a proxied body over 100 MB before it reaches us.
UPLOAD_MAX_VIDEO_MB=95
UPLOAD_MAX_DOCUMENT_MB=20
UPLOAD_TMP_DIR=
FILE_UNUSED_GRACE_HOURS=24

# --- Redis / BullMQ (optional; REDIS_URL required when enabled) ---
# The instance must run with maxmemory-policy=noeviction or BullMQ drops jobs.
# Also backs the rate limiters. With Redis off they count in process
# memory, which is only correct at one instance: N instances behind a
# load balancer make every limit N times looser, silently. Switch this on
# before scaling out. A Redis outage degrades limiting to "allow", it
# does not fail requests. The app warns at startup when this is off in
# production.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_PREFIX=bull

# --- Transactional email (Resend; optional) ---
# When enabled, RESEND_API_KEY and EMAIL_FROM_ADDRESS are required.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM_NAME=Acme Store
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=
